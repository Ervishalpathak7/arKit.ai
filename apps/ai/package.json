{
  "name": "@archiq/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "docker:dev": "docker compose -f ../../docker-compose.dev.yml up --build ai",
    "docker:dev:down": "docker compose -f ../../docker-compose.dev.yml down",
    "docker:logs": "docker compose -f ../../docker-compose.dev.yml logs -f ai"
  },
  "devDependencies": {
    "@archiq/config": "workspace:*",
    "@archiq/eslint-config": "workspace:*",
    "@archiq/types": "workspace:*",
    "@types/node": "^22.15.3",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.8.17",
    "npm-run-all": "^4.1.5",
    "typescipt": "^1.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@archiq/log": "workspace:*",
    "@archiq/cache": "workspace:*",
    "@archiq/db": "workspace:*",
    "@archiq/queue": "workspace:*"
  }
}
