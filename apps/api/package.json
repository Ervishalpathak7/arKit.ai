{
  "name": "@archiq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest",
    "docker:dev": "docker compose -f ../../docker-compose.dev.yml up --build api",
    "docker:dev:fresh": "docker compose -f docker-compose.dev.yml build --no-cache && docker compose -f docker-compose.dev.yml up",
    "docker:dev:down": "docker compose -f ../../docker-compose.dev.yml down",
    "docker:logs": "docker compose -f ../../docker-compose.dev.yml logs -f api"
  },
  "devDependencies": {
    "@archiq/config": "workspace:*",
    "@archiq/eslint-config": "workspace:*",
    "@archiq/types": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@archiq/cache": "workspace:*",
    "@archiq/db": "workspace:*",
    "@archiq/log": "workspace:*",
    "@archiq/queue": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "zod": "^4.4.3"
  }
}
