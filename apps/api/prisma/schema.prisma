
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @default(cuid())
  firstName     String?
  lastName      String?
  email         String        @unique
  plan          Plan          @default(FREE)
  credit        Int           @default(5)
}

enum Plan {
  FREE 
  PRO
  MAX
}