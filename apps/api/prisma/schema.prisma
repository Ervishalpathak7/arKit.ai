generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatar    String
  clerkId   String   @unique
}

model Design {
  id            String   @id @default(cuid())
  authorId      String
  title         String?
  description   String?
  techStack     String?
  body          Json?
  createdAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
