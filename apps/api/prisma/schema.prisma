
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  firstName     String?
  lastName      String?
  email         String        @unique
  plan          Plan          @default(FREE)
  credit        Int           @default(5)
}

enum Plan {
  FREE 
  PRO
  MAX
}

model Design {
  id          String          @id @default(cuid())
  title       String?
  body        Json?
  authorId    String
  prompt      String
  status      DesignStatus    @default(PROCESSING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum DesignStatus {
  PROCESSING
  READY
  FAILED
}