{
  "name": "archiq",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "build:api": "turbo build --filter=@archiq/api",
    "build:ai": "turbo build --filter=@archiq/ai",
    "build:web": "turbo build --filter=@archiq/web",
    "dev:api": "turbo dev --filter=@archiq/api",
    "dev:api:docker": "docker compose -f docker-compose.yml up -d --build api",
    "dev:ai": "turbo dev --filter=@archiq/ai",
    "dev:web": "turbo dev --filter=@archiq/web"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
